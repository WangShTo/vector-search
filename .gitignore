# Java
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# 模型缓存（体积大，不入库）
.cache/
models/
*.onnx
*.bin
*.safetensors

# 索引数据
data/index/
data/*.bin
data/*.idx

# 评测产物
# 注意：基线与并发数据要保留 —— 它们是 bench/REPORT.md 里表格的原始来源，
# 提交它们才能让报告可复现（报告是脚本生成的，但数据得有）。
bench/results/*
!bench/results/recall-baseline.json
!bench/results/concurrent-baseline.json
!bench/results/concurrent-optimized.json
eval/results/

# 服务运行日志（dev.ps1 产生）
logs/

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS
.DS_Store
Thumbs.db
