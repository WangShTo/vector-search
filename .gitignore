# Java
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# 模型缓存（体积大，不入库）
.cache/
models/
*.onnx
*.bin
*.safetensors

# 索引数据
# 注意用 **/ 前缀：data-dir 是相对「服务进程工作目录」解析的，
# 从 vector-search-java/ 启动时索引会落在 vector-search-java/data/index/。
# 只写 data/index/ 的话只匹配项目根目录，嵌套的那份会被误提交。
**/data/index/
data/*.bin
data/*.idx

# 评测集是 build_dataset.py 的产物，不入库：
# 语料一变它就失效了，提交进去只会变成过期的假数据。
data/eval/

# 组装出来的评测语料是项目文件的副本，用 eval/assemble_corpus.py 随时重建。
# 提交副本只会让仓库多一份会过期的复制品。
data/corpus-full/

# Archify 的绘图工作目录：候选 JSON、多轮门禁回执、截图。
# 这些是生成过程的中间证据；正式产物已同步到
# docs/architecture.html / .png / .source.json。
# 需要重建时拿 docs/architecture.source.json 跑一遍即可。
.archify/

# 评测产物
# 注意：基线与并发数据要保留 —— 它们是 bench/REPORT.md 里表格的原始来源，
# 提交它们才能让报告可复现（报告是脚本生成的，但数据得有）。
bench/results/*
!bench/results/recall-baseline.json
!bench/results/concurrent-baseline.json
!bench/results/concurrent-optimized.json
eval/results/

# 服务运行日志（dev.ps1 产生）
logs/

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS
.DS_Store
Thumbs.db
