<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.vectorsearch</groupId>
  <artifactId>vector-search-java</artifactId>
  <version>0.1.0</version>
  <name>vector-search-java</name>
  <description>自研 HNSW 向量检索服务</description>

  <properties>
    <java.version>17</java.version>
    <jmh.version>1.37</jmh.version>
    <!--
      源码里大量中文注释，编码必须显式声明为 UTF-8。
      虽然 spring-boot-starter-parent 已默认设置，但这里写清楚，
      避免换 parent 或在别的环境构建时出现乱码。
    -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      JDK Vector API（SIMD 距离计算）在 Java 17 与 21 中仍是 incubator 模块，
      必须显式加模块选项才能编译与运行。

      两个必须注意的坑：

      1. XML 注释里不能出现连续两个减号，所以本注释刻意不写出那个选项的字面形式。

      2. 模块选项与模块名必须作为两个独立参数传给 javac。
         如果拼成一个参数（中间带空格），javac 会报「无效的标记」。
         详见下面 compilerArgs 与 jvmArguments 的写法。
    -->
    <vector.api.module>jdk.incubator.vector</vector.api.module>
    <!-- surefire 的 argLine 按命令行字符串解析，所以要拼成一个整体 -->
    <vector.api.args>--add-modules ${vector.api.module}</vector.api.args>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 本地缓存：热点 query 到检索结果的映射 -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- JMH：微基准，用于量化 SIMD 与堆外内存改造的收益 -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- 两个独立 arg，不能合并 -->
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>${vector.api.module}</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${vector.api.args}</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            注意：这里的 jvmArguments 是「字符串」类型，不是列表。
            写成 <jvmArgument> 子元素会报 "must not contain child elements"。
            插件会按空白把这个字符串切成多个 JVM 参数，所以拼在一起是对的。
            这一点和上面 maven-compiler-plugin 的 compilerArgs（列表）相反 —— 两者容易搞混。
          -->
          <jvmArguments>${vector.api.args}</jvmArguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
