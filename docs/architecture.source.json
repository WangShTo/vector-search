  "cards": [
    {
      "dot": "cyan",
      "title": "一次检索走的路",
      "items": [
        "客户端 → REST 接口 → 检索编排，然后同时走两条召回",
        "两条召回的结果由 RRF 融合，再交给精排重新排序",
        "响应携带分阶段耗时（编码 / 检索 / 融合），避免优化方向选错"
      ]
    },
    {
      "dot": "emerald",
      "title": "两条召回路线为什么都要",
      "items": [
        "稠密擅长语义泛化：「内存回收」能匹配到「垃圾回收」",
        "稀疏擅长精确词：efSearch、HNSW 这类标识符只有它能精确命中",
        "实测：词面查询 BM25 0.96 而向量 0.80；语义查询反转为 0.63 对 0.88"
      ]
    },
    {
      "dot": "amber",
      "title": "精排为什么值得多花几百毫秒",
      "items": [
        "向量检索是双塔：查询与文档各自独立编码，编码时两者没见过彼此",
        "cross-encoder 把两者拼在一起送进模型，能做完整的注意力交互",
        "实测 MRR 提升 9% 至 14%，而召回率完全不变",
        "默认关闭：质量与延迟的权衡应由业务决定，不该由框架替用户决定"
      ]
    },
    {
      "dot": "slate",
      "title": "持久化解决的不是「省事」",
      "items": [
        "10 万条数据重建 HNSW 图要 113 秒，这是每次冷启动都要付的成本",
        "二进制快照恢复只要 173 毫秒，加速 654 倍",
        "BM25 不需要快照：从 documents.jsonl 重建即可，比建图便宜几个数量级"
      ]
    }
  ]
