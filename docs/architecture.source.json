  "cards": [
    {
      "dot": "cyan",
      "title": "一次检索走的路",
      "items": [
        "客户端 → REST 接口 → 检索编排，查询向量由 Python 侧编码",
        "同时走两条召回：HNSW 稠密 + BM25 稀疏，来源与删除判断都在遍历里完成",
        "两路的最高原始分先过拒答判定，不达标直接返回空结果，不进入融合",
        "达标才做加权 RRF 融合；开了精排再交给 cross-encoder 重排",
        "响应带分阶段耗时（编码 / 检索 / 融合），免得把瓶颈找错地方"
      ]
    },
    {
      "dot": "emerald",
      "title": "两条召回为什么都要",
      "items": [
        "稠密擅长语义泛化：「内存回收」能匹配到「垃圾回收」",
        "稀疏擅长精确词：efSearch、HNSW 这类标识符只有它能精确命中",
        "实测：词面查询 BM25 0.96 而向量 0.80；语义查询反转为 0.63 对 0.88",
        "融合按名次而不按分数 —— 两路分数尺度不可比，加权后仍以名次为准"
      ]
    },
    {
      "dot": "amber",
      "title": "拒答为什么卡在融合之前",
      "items": [
        "RRF 的分是 1/(k+rank) 累加，k=60 时被压在 0.016~0.033 的窄带里",
        "它衡量的是排名靠不靠前，跟相关不相关没关系 —— 拿它做阈值是拿错尺子",
        "所以取融合之前的两路原始分：余弦有界可比，BM25 最高分随语料漂",
        "实测负样本拒答率 84%，正样本零误拒；漏拒主要栽在词汇重叠"
      ]
    },
    {
      "dot": "slate",
      "title": "持久化与运维",
      "items": [
        "10 万条重建 HNSW 图要 113 秒，二进制快照恢复只要 173 毫秒",
        "快照记录精度标记与量化刻度，否则读回来会用错的刻度解码",
        "删除只打墓碑，占比到 10% 由后台单飞压实（活节点重建 + 清墓碑）",
        "BM25 不需要快照：从 documents.jsonl 重建比建图便宜几个数量级"
      ]
    }
  ]
