  "cards": [
    {
      "dot": "cyan",
      "title": "一次检索的路径",
      "items": [
        "客户端 → REST 接口 → 检索编排 → 索引 → 回填原文",
        "响应携带分阶段耗时（编码 / 检索），避免优化方向选错"
      ]
    },
    {
      "dot": "amber",
      "title": "跨进程边界：本项目的性能关键",
      "items": [
        "Java 与 Python 是两个独立进程，每次调用都是一次网络往返",
        "/embed 从设计上就是批量接口，把 N 次往返压成 1 次",
        "实测编码 25 到 38 ms，而索引检索不到 1 ms —— 瓶颈在这里"
      ]
    },
    {
      "dot": "emerald",
      "title": "索引核心",
      "items": [
        "HNSW 从零实现：分层邻近图 / 贪心下降 / 启发式邻居选择",
        "暴力检索既是正确性基准，也是所有性能数字的对照组",
        "距离计算保留标量与 SIMD 双实现，收益可量化（4.97 倍）"
      ]
    },
    {
      "dot": "slate",
      "title": "尚未接入的部分（避免误读）",
      "items": [
        "BM25 + RRF 混合召回、Cross-Encoder 精排：已实现，未接入检索链路",
        "堆外内存 / StampedLock 乐观读 / 索引持久化：计划中"
      ]
    }
